# qwen-coder-server runtime configuration
# Copy this file to /opt/qwen-coder/config/qwen-coder.env and edit it.

LLAMA_API_KEY=CHANGE_ME
LLAMA_HOST=0.0.0.0
LLAMA_PORT=8090
LLAMA_THREADS=12
LLAMA_THREADS_BATCH=12
LLAMA_CONTEXT=8192
LLAMA_PARALLEL=1
LLAMA_BATCH=512
LLAMA_UBATCH=256

MODEL_DIR=/opt/qwen-coder/models
MODEL_REPO=BlossomsAI/Qwen2.5-Coder-14B-Instruct-Uncensored-GGUF
MODEL_QUANT=Q5_K_M
